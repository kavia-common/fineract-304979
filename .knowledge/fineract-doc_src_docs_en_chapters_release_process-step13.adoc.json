{"is_source_file": true, "format": "AsciiDoc", "description": "This file provides instructions and step-by-step guidance for closing a release branch in a software project, specifically in the context of Git and Gradle commands used for version management and release process finalization.", "external_files": ["https://issues.apache.org/jira/browse/FINERACT-1154", "https://github.com/apache/fineract#merge-strategy"], "external_methods": [], "published": [], "classes": [], "methods": [], "calls": ["git checkout develop", "git merge release/{revnumber}", "git push origin develop", "git branch -D release/{revnumber}", "git push origin :release/{revnumber}", "git describe", "./gradlew fineractReleaseStep13 -Pfineract.release.version={revnumber}"], "search-terms": ["release branch", "close release", "git describe", "Gradle task", "release process", "Fineract-1154", "release tag"], "state": 2, "file_id": 6049, "knowledge_revision": 18409, "git_revision": "67272d1aea163da9bebdf6ff56ead270bd47632d", "hash": "2babba5d1854d2623d9607ef32ff6469", "format-version": 4, "code-base-name": "fineract-304979", "filename": "fineract-doc/src/docs/en/chapters/release/process-step13.adoc", "revision_history": [{"18409": "67272d1aea163da9bebdf6ff56ead270bd47632d"}]}