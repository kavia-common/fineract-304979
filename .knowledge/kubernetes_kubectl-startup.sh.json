{"is_source_file": true, "format": "bash", "description": "This script automates the setup and deployment of the Apache Fineract service components in a Kubernetes environment. It creates secrets, applies configuration maps, deploys MySQL and Fineract server pods, and waits for each to reach the 'Running' state before proceeding to the next step, including deploying the Mifos Community UI.", "external_files": ["fineractmysql-configmap.yml", "fineractmysql-deployment.yml", "fineract-server-deployment.yml", "fineract-mifoscommunity-deployment.yml"], "external_methods": ["kubectl create secret", "kubectl apply", "kubectl get pods"], "published": [], "classes": [], "methods": [], "calls": ["kubectl create secret generic fineract-tenants-db-secret --from-literal=username=root --from-literal=password=$(head /dev/urandom | LC_CTYPE=C tr -dc A-Za-z0-9 | head -c 16))", "kubectl apply -f fineractmysql-configmap.yml", "kubectl apply -f fineractmysql-deployment.yml", "kubectl get pods -l tier=fineractmysql --template '{{range .items}}{{.metadata.name}}{{\"\\n\"}}{{end}}'", "kubectl get pods ${fineractmysql_pod} --no-headers -o custom-columns=\":status.phase\"", "kubectl apply -f fineract-server-deployment.yml", "kubectl get pods -l tier=backend --template '{{range .items}}{{.metadata.name}}{{\"\\n\"}}{{end}}'", "kubectl get pods ${fineract_server_pod} --no-headers -o custom-columns=\":status.phase\"", "kubectl apply -f fineract-mifoscommunity-deployment.yml", "kubectl get pods -l tier=backend --template '{{range .items}}{{.metadata.name}}{{\"\\n\"}}{{end}}'", "kubectl get pods ${fineract_mifoscommunity_pod} --no-headers -o custom-columns=\":status.phase\""], "search-terms": ["kubernetes", "deployment", "Fineract", "shell script", "microservices", "kubectl", "automation"], "state": 2, "file_id": 5053, "knowledge_revision": 17420, "git_revision": "ccff5d8ad23a3b446846e5e84f973994d022feed", "hash": "c80ead0487932950de9984e4e35d5f34", "format-version": 4, "code-base-name": "finerac